# One funded key runs everything on testnet: it deploys the three contracts
# and funds every role key (derived from it) - buyer, challenger, 5 GPU
# providers, 3 verifiers. Use a fresh testnet-only wallet.
LOOM_PRIVATE_KEY=0x...

